    "@astrojs/starlight": "^0.41.7",
    "@astrojs/svelte": "^9.0.1",
    "@astrojs/vue": "^7.0.2",
    "@base-ui/react": "^1.7.0",
    "@egoist/tailwindcss-icons": "^1.9.2",
    "@iconify-json/bxl": "^1.2.4",
    "@iconify-json/logos": "^1.2.12",
    "@iconify-json/lucide": "^1.2.123",
    "@iconify-json/tabler": "^1.2.37",
